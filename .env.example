# .env.local にコピーして値を入れる（.env.local は git に入れない）
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- 使う人ごとに違う値（書かなければ、コードにある仮の値になる） ---
# アプリ（src/lib/personal.ts）と Edge Function（supabase/functions/_shared/personal.ts）の両方が読む。
# アプリの分は EAS の環境変数にも、Edge Function の分は Supabase のシークレットにも同じ名前で入れる

# メールからの記録で見るメールの送信元
EXPO_PUBLIC_MAIL_SENDER_DEBIT=debit@example.com
EXPO_PUBLIC_MAIL_SENDER_BANK=bank@example.com
EXPO_PUBLIC_MAIL_SENDER_CARD=card@example.com
EXPO_PUBLIC_MAIL_SENDER_ELECTRICITY=electricity@example.com
EXPO_PUBLIC_MAIL_SENDER_GAS=gas@example.com
# 入出金のお知らせが来る銀行（件名の「◯◯にて入金がありました」の ◯◯）と、それを送ってくる口座連携サービス
EXPO_PUBLIC_MAIL_BANK_NAME=サンプル銀行
EXPO_PUBLIC_MAIL_BANK_SERVICE=口座連携サービス
# デビットカードの名前と、銀行の出金のお知らせでのデビットカードの名目
EXPO_PUBLIC_MAIL_DEBIT_NAME=サンプルデビット
EXPO_PUBLIC_MAIL_DEBIT_NAME_IN_BANK=サンプルデビット
# クレジットカードの名前
EXPO_PUBLIC_MAIL_CARD_NAME=サンプルカード
# 電子マネーの口座の名前の一部と、銀行の出金の名目での読み（JSON）
EXPO_PUBLIC_TOPUP_ALIASES={"サンプル電子マネー":["サンプルデンシマネー"]}
# お店ごとに払う口座（どちらも正規表現。JSON の配列）
EXPO_PUBLIC_STORE_ACCOUNT_RULES=[{"store":"サンプル店","account":"サンプル電子マネ"}]

# --- テストで使う名前（src/testing/samples.ts。アプリでは使わない） ---
SAMPLE_FRIEND_NAME=健太
SAMPLE_FRIEND_NAME_2=さくら
SAMPLE_REMITTER_NAME=ヤマダ タロウ
SAMPLE_EMPLOYER_NAME=acmeworks
SAMPLE_RESERVED_ACCOUNT_NAME=サークルの財布
